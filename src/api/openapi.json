  "components": {
    "securitySchemes": {
      "UserKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-User-Id",
        "description": "Unique user identifier (UUID) assigned at onboarding, included in all API requests"
      }
    },
    "parameters": {
      "EntityId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "Entity ID"
      }
    },
    "responses": {
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" },
          "details": { "type": "string" }
        }
      },
      "Frequency": {
        "type": "object",
        "required": ["value", "unit", "startDate"],
        "properties": {
          "value": { "type": "integer", "description": "Every N units" },
          "unit": { "type": "string", "enum": ["D", "W", "M", "Y"], "description": "Day, Week, Month, Year" },
          "startDate": { "type": "string", "format": "date", "description": "Start date of the frequency" }
        }
      },
      "Category": {
        "type": "object",
        "required": ["id", "name", "icon", "defaultDirection", "color", "order", "updatedAt"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "nameKey": { "type": "string", "description": "i18n key for dynamic translation" },
          "icon": { "type": "string", "description": "Lucide icon name" },
          "defaultDirection": { "type": "string", "enum": ["credit", "debit"] },
          "color": { "type": "string", "description": "Hex color" },
          "order": { "type": "integer" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "CategoryNew": {
        "type": "object",
        "required": ["name", "icon", "defaultDirection", "color", "order"],
        "properties": {
          "name": { "type": "string" },
          "nameKey": { "type": "string" },
          "icon": { "type": "string" },
          "defaultDirection": { "type": "string", "enum": ["credit", "debit"] },
          "color": { "type": "string" },
          "order": { "type": "integer" }
        }
      },
      "CategoryUpdate": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "nameKey": { "type": "string" },
          "icon": { "type": "string" },
          "defaultDirection": { "type": "string", "enum": ["credit", "debit"] },
          "color": { "type": "string" },
          "order": { "type": "integer" }
        }
      },
      "Account": {
        "type": "object",
        "required": ["id", "name", "description", "currency", "color", "icon", "initialBalance", "isDefaultSavings", "isDefaultExpenses", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "currency": { "type": "string", "description": "ISO 4217 currency code" },
          "color": { "type": "string" },
          "icon": { "type": "string" },
          "initialBalance": { "type": "number" },
          "isDefaultSavings": { "type": "boolean" },
          "isDefaultExpenses": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "AccountNew": {
        "type": "object",
        "required": ["name", "description", "currency", "color", "icon", "initialBalance", "isDefaultSavings", "isDefaultExpenses"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "currency": { "type": "string" },
          "color": { "type": "string" },
          "icon": { "type": "string" },
          "initialBalance": { "type": "number" },
          "isDefaultSavings": { "type": "boolean" },
          "isDefaultExpenses": { "type": "boolean" }
        }
      },
      "AccountUpdate": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "currency": { "type": "string" },
          "color": { "type": "string" },
          "icon": { "type": "string" },
          "initialBalance": { "type": "number" },
          "isDefaultSavings": { "type": "boolean" },
          "isDefaultExpenses": { "type": "boolean" }
        }
      },
      "TransactionEffect": {
        "type": "object",
        "required": ["id", "transactionId", "accountId", "direction", "amount", "categoryId"],
        "properties": {
          "id": { "type": "string" },
          "transactionId": { "type": "string" },
          "accountId": { "type": "string" },
          "direction": { "type": "string", "enum": ["credit", "debit"] },
          "amount": { "type": "number" },
          "categoryId": { "type": "string" }
        }
      },
      "TransactionEffectNew": {
        "type": "object",
        "required": ["accountId", "direction", "amount", "categoryId"],
        "properties": {
          "accountId": { "type": "string" },
          "direction": { "type": "string", "enum": ["credit", "debit"] },
          "amount": { "type": "number" },
          "categoryId": { "type": "string" }
        }
      },
      "Transaction": {
        "type": "object",
        "required": ["id", "amount", "currency", "date", "time", "description", "effects", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string" },
          "amount": { "type": "number" },
          "currency": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "time": { "type": "string" },
          "description": { "type": "string" },
          "effects": {

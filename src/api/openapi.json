{
  "openapi": "3.0.3",
  "info": {
    "title": "BilluYo API",
    "version": "0.1.0",
    "description": "REST API for BilluYo personal finance tracker"
  },
  "servers": [
    {
      "url": "https://billuyoapi.local",
      "description": "Local development"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health check",
        "tags": ["System"],
        "security": [],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" }
                  }
                }
              }
            }
          }
        }
      }
    },
